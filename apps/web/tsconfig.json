{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@clinical/uterus": [
        "./packages/clinical-uterus/src/index.ts"
      ],
      "@clinical/uterus/*": [
        "./packages/clinical-uterus/src/*"
      ],
      "@repo/cervix-pathology-reference": [
        "../../packages/cervix-pathology-reference/src/index.ts"
      ],
      "@repo/cervix-pathology-reference/*": [
        "../../packages/cervix-pathology-reference/*"
      ],
      "@repo/clinical-reference": [
        "../../packages/clinical-reference/src/index.ts"
      ],
      "@repo/nosology": [
        "../../packages/nosology/src/index.ts"
      ],
      "@repo/clinical-3d": [
        "../../packages/clinical-3d/src/index.ts"
      ],
      "@repo/clinical-3d/*": [
        "../../packages/clinical-3d/src/*"
      ],
      "@repo/obstetric-atlas": [
        "../../packages/obstetric-atlas/src/index.ts"
      ],
      "@repo/obstetric-atlas/*": [
        "../../packages/obstetric-atlas/src/*"
      ],
      "@repo/adnex-education": [
        "../../packages/adnex-education/src/index.ts"
      ],
      "@repo/adnex-education/*": [
        "../../packages/adnex-education/src/*"
      ],
      "@repo/medical-calculations": [
        "../../packages/medical-calculations/src/index.ts"
      ],
      "@repo/medical-calculations/*": [
        "../../packages/medical-calculations/src/*"
      ],
      "@repo/report-engine": [
        "../../packages/report-engine/src/index.ts"
      ],
      "@repo/report-engine/*": [
        "../../packages/report-engine/src/*"
      ],
      "@repo/education-quiz": [
        "../../packages/education-quiz/src/index.ts"
      ],
      "@repo/education-quiz/*": [
        "../../packages/education-quiz/src/*"
      ],
      "@repo/types": [
        "../../packages/types/src/index.ts"
      ],
      "@repo/types/*": [
        "../../packages/types/src/*"
      ],
      "@repo/orads-us": [
        "../../packages/orads-us/src/index.ts"
      ],
      "@repo/orads-us/*": [
        "../../packages/orads-us/*"
      ],
      "@repo/birads-us": [
        "../../packages/birads-us/src/index.ts"
      ],
      "@repo/birads-us/*": [
        "../../packages/birads-us/*"
      ],
      "@repo/ln-rads-us": [
        "../../packages/ln-rads-us/src/index.ts"
      ],
      "@repo/ln-rads-us/*": [
        "../../packages/ln-rads-us/*"
      ],
      "@repo/tirads-acr": [
        "../../packages/tirads-acr/src/index.ts"
      ],
      "@repo/tirads-acr/*": [
        "../../packages/tirads-acr/*"
      ],
      "@repo/thyroid-tirads": [
        "../../packages/thyroid-tirads/src/index.ts"
      ],
      "@repo/thyroid-tirads/*": [
        "../../packages/thyroid-tirads/*"
      ],
      "@repo/upload-validation": [
        "../../packages/upload-validation/src/index.ts"
      ],
      "@repo/upload-validation/*": [
        "../../packages/upload-validation/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "supabase/functions",
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 3.ts",
    "**/* 3.tsx"
  ]
}

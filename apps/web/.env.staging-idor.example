# Copy to .env.staging-idor (gitignored) — synthetic test accounts on STAGING only.
# Preflight blocks prod Supabase ref and production app hosts (see docs/operations/staging-idor-quickstart.md).

STAGING_APP_URL=http://localhost:3000
# Supabase ref that this app URL uses (Supabase branch — NOT grnwcbyslttbrqznnunq unless you explicitly accept prod writes):
STAGING_SUPABASE_PROJECT_REF=your-branch-ref-here

IDOR_USER_A_EMAIL=
IDOR_USER_A_PASSWORD=
IDOR_USER_B_EMAIL=
IDOR_USER_B_PASSWORD=
# IDOR_PATIENT_A_ID=

# Emergency only — IDOR smoke creates a patient on prod DB:

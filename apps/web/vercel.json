{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npx --yes pnpm@10.6.5 install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @repo/web build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sonogyn-pro.ru" }],
      "destination": "https://www.sonogyn-pro.ru/:path*",
      "permanent": true
    }
  ]
}

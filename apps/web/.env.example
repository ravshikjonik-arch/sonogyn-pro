# Next.js (`apps/web`) — never commit real secrets

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Прямое подключение Postgres для npm run db:migrate (Settings → Database → URI)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Prisma (опционально, coexistence с Supabase). DATABASE_URL — pooled, DIRECT_URL — прямое (для migrate/diff).
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres
# Seed администратора (npx prisma db seed)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Администратор
# Базовый URL приложения: email confirm, OAuth, redirectTo.
# Production (Vercel): https://sonogyn-pro.ru
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Локальный автовход (только npm run dev, NODE_ENV=development). В production/Vercel — не задавать.
DEV_AUTO_LOGIN=false
# Режим разработки: длинная сессия (90 д), auto-confirm email, без выхода после 24ч офлайна.
# Требует SUPABASE_SERVICE_ROLE_KEY для server-side confirm. Только local dev — скопируйте в apps/web/.env.local:
DEV_AUTH_MODE=true
AUTH_SESSION_MAX_AGE_DAYS=90
AUTH_AUTO_CONFIRM_EMAIL=true
# Обход логина без Supabase (только local dev). Никогда не включать на Vercel/production.
DEV_SKIP_AUTH=false
# DEV_LOGIN_EMAIL=yakubovr564@gmail.com
# DEV_LOGIN_EMAIL=ravshikjonik@mail.ru
DEV_LOGIN_PASSWORD=your-dev-password
DEV_LOGIN_FULL_NAME=Якубов Равшан Вахобжонович
DEV_LOGIN_BIRTH_YEAR=1988
DEV_LOGIN_SPECIALIZATION=Акушер-гинеколог
DEV_LOGIN_INSTITUTION=Учреждение

# Telegram Bot (Telegram Login Widget)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SonogynProBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=SonogynProBot
# Админы для уведомлений (chat_id через запятую). Инструкция: apps/web/services/TELEGRAM_SETUP.md
TELEGRAM_ADMIN_IDS=

# Cron (/api/cron/daily-summary) и POST /api/notify — Bearer или x-cron-secret
# CRON_SECRET=

# SMS OTP (РФ: SMS.ru; международный: Twilio). Без этого — вкладка «Телефон» шлёт код только через Supabase+Twilio.
# SMS_PROVIDER=smsru
# SMSRU_API_ID=           # https://sms.ru → Настройки → API
# SMSRU_FROM=SonoGyn      # согласованное имя отправителя — быстрее доставка на +7 (не «общее имя»)
# NEXT_PUBLIC_AUTH_PILOT_TELEGRAM_PRIMARY=true  # Telegram — основной таб; SMS дублирует код на +7
# Закрытый пилот до 10 врачей: Telegram ID через запятую (chat_id, не @username). Пример:
# AUTH_PILOT_TELEGRAM_ALLOWLIST=310996807,123456789
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Секрет для server-to-server (chat-server → /api/auth/telegram/bot). ОБЯЗАТЕЛЬНО сменить в production.
SONOGYN_AUTH_INTERNAL_SECRET=

# Hermes Telegram → учебный пример (draft teaching case + media)
# TELEGRAM_EXAMPLE_INGEST_SECRET=          # Bearer для POST /api/ingest/telegram-example
# TELEGRAM_EXAMPLE_ALLOWED_USER_IDS=310996807
# TELEGRAM_EXAMPLE_OWNER_USER_ID=          # optional override; else resolve by telegram_id metadata
# TELEGRAM_HERMES_BOT_TOKEN=              # optional; иначе TELEGRAM_BOT_TOKEN
# TELEGRAM_HERMES_WEBHOOK_SECRET=         # x-telegram-bot-api-secret-token для /api/telegram/hermes

# OAuth (основная настройка — Supabase Dashboard → Authentication → Providers)
# Google: включите Google, укажите Client ID/Secret из Google Cloud Console.
# Redirect URI в Google: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# Site URL / Redirect URLs в Supabase: NEXT_PUBLIC_APP_URL и /auth/callback
NEXT_PUBLIC_VK_CLIENT_ID=
NEXT_PUBLIC_YANDEX_CLIENT_ID=

STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=price_...

# ЮKassa (РФ, production billing). Webhook: https://sonogyn-pro.ru/api/yookassa/webhook
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_PRO_PRICE_RUB=990
# TELEGRAM_ADMIN_CHAT_ID=          # уведомления об оплате
# YOOKASSA_WEBHOOK_SKIP_IP_CHECK=true  # только local dev webhook-тесты

# HTTP retry для sms.ru / ЮKassa / Telegram (defaults: 3 попытки, 15 с таймаут)
# HTTP_RETRY_ATTEMPTS=3
# HTTP_FETCH_TIMEOUT_MS=15000
# HTTP_RETRY_BASE_DELAY_MS=500

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_SENTRY_DSN=

# Rate limiting (production, multi-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AUTH_RATE_LIMIT_RELAXED=true  # только временно на staging; не в production
# BOT_DETECTION_ENABLED=false   # по умолчанию включено (блок scrapers на /api/*)

# Настройка лимитов без деплоя (limit + window в секундах). Примеры:
# RATE_LIMIT_AUTH_SIGN_IN=20
# RATE_LIMIT_AUTH_SIGN_IN_WINDOW_SEC=900
# RATE_LIMIT_AUTH_MFA_VERIFY=20
# RATE_LIMIT_AUTH_MFA_VERIFY_WINDOW_SEC=900
# RATE_LIMIT_AUTH_SESSION=120
# RATE_LIMIT_AUTH_SESSION_WINDOW_SEC=60
# RATE_LIMIT_PATIENTS_SEARCH=120
# RATE_LIMIT_PATIENTS_SEARCH_WINDOW_SEC=60
# RATE_LIMIT_PATIENTS_SEARCH_PER_USER=60
# RATE_LIMIT_AI_ORADS=40
# RATE_LIMIT_AI_ORADS_BURST=5
# RATE_LIMIT_AI_ORADS_BURST_WINDOW_SEC=10
# RATE_LIMIT_AI_ANALYZE_POLL=120
# RATE_LIMIT_AI_ANALYZE_POLL_WINDOW_SEC=60
# RATE_LIMIT_SYNC_BURST=30
# RATE_LIMIT_SYNC_BURST_WINDOW_SEC=60
# RATE_LIMIT_COPILOT_STUDY_CREATE=30
# RATE_LIMIT_COPILOT_STUDY_CREATE_WINDOW_SEC=60
# Полный список: apps/web/lib/security/rate-limit-config.ts

# Server-only AI (never EXPO_PUBLIC_*)
# Текст / SonoEvidence: Perplexity (ключ с perplexity.ai). Vision/O-RADS картинки: OpenRouter.
PERPLEXITY_API_KEY=
# PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_EVIDENCE_MODEL=sonar-pro
# LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_ORADS_MODEL=openai/gpt-4o-mini
# OPENROUTER_EVIDENCE_MODEL=openai/gpt-4o-mini
# OPENROUTER_US_VISION_MODEL=openai/gpt-4o-mini

# Evidence retrieval (PubMed, Cochrane, WHO/NICE/EMA, КР МЗ РФ)
# NCBI_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=support@sonogyn.pro
# EVIDENCE_ENRICH_REPORTS=1          # live EBM citations in SRE reports (default on)
# EVIDENCE_CLINICAL_HINTS=1          # compact EBM context in clinical Sonogyn chat

# CPI AI colposcopy (POST /api/cpi/ai/analyze — optional external vision service)
# CPI_AI_COLPOSCOPY_URL=https://your-colposcopy-ai.example/analyze
# CPI_AI_COLPOSCOPY_API_KEY=

# PubMed / NCBI E-utilities (опционально, для /api/pubmed/abstracts)
# NCBI_API_KEY=

# Видео уроков: Yandex Object Storage (S3) или Vercel Blob
# STORAGE_PROVIDER=yandex
# STORAGE_BUCKET=sonogyn-lessons
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=https://storage.yandexcloud.net
# STORAGE_REGION=ru-central1
# PLAYBACK_TOKEN_SECRET=          # подпись HLS proxy (иначе — часть service role key)
# VIDEO_TRANSCODE_WEBHOOK_URL=    # внешний ffmpeg-сервис (Cloud Run / VM)
# VIDEO_TRANSCODE_WEBHOOK_SECRET=

# Вебинары · LiveKit (прямой эфир внутри SonoGyn Pro)
# Cloud: https://cloud.livekit.io → Project → Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ALLOW_LOCAL_FFMPEG_TRANSCODE=true
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# BLOB_READ_WRITE_TOKEN=          # только если STORAGE_PROVIDER=vercel-blob

# Email-only pilot: true = только вкладка «Почта», без SMS/Telegram/Яндекс и без /verify-phone
AUTH_EMAIL_ONLY=true
NEXT_PUBLIC_AUTH_EMAIL_ONLY=true
# false = пользователь подтверждает email по ссылке из письма (Mail.ru SMTP)
AUTH_AUTO_CONFIRM_EMAIL=false

# SMTP Mail.ru — рассылки SonoGyn Pro (подтверждение email, OTP, те же creds в Supabase Auth SMTP)
# SMTP_HOST=smtp.mail.ru
# SMTP_CONNECT_HOST=217.69.139.160
# SMTP_PORT=465
# SMTP_USER=Sonogyn-pro@mail.ru
# SMTP_PASSWORD=
# SMTP_FROM=SonoGyn Pro <Sonogyn-pro@mail.ru>
# Supabase: node scripts/configure-supabase-smtp.mjs --apply (SUPABASE_ACCESS_TOKEN)
# SUPABASE_ACCESS_TOKEN=

// Prisma schema — SonoGyn Pro
//
// ВАЖНО: проект работает на Supabase Auth (auth.users) + Supabase migrations.
// Эта схема добавлена ОТДЕЛЬНО (coexistence): таблицы маппятся на собственные
// имена (@@map с суффиксами), чтобы НЕ перезаписать существующие таблицы Supabase
// (public.profiles, public.payments) и не сломать RLS / auth.*.
//
// НЕ запускайте `prisma migrate dev` против боевой Supabase-БД — Prisma увидит
// drift (auth-схему, RLS, существующие таблицы) и может предложить reset.
// Для применения используйте сгенерированный prisma/init.sql через Supabase SQL Editor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (Supabase: ...pooler.supabase.com:6543/postgres?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Прямое подключение для миграций/diff (Supabase: db.<ref>.supabase.co:5432)
  directUrl = env("DIRECT_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String?           @unique
  name          String?
  phone         String?           @unique
  phoneVerified Boolean           @default(false)
  image         String?
  role          String            @default("user") // user, admin
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  accounts      Account[]
  sessions      Session[]
  payments      Payment[]
  smsCodes      SMSVerification[]

  @@map("prisma_users")
}

// NextAuth — стандартная модель OAuth-аккаунтов
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("prisma_accounts")
}

// NextAuth — стандартная модель сессий
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prisma_sessions")
}

// NextAuth — токены подтверждения email
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("prisma_verification_tokens")
}

model SMSVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId])
  @@map("prisma_sms_verifications")
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int      // в копейках
  currency     String   @default("RUB")
  status       String   @default("pending") // pending, succeeded, canceled
  yookassaId   String?  @unique
  description  String?
  returnUrl    String?
  confirmation Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@map("prisma_payments")
}

// ---------------------------------------------------------------------------
// Геймификация «Звёзды и награды» (Supabase auth.users.id → userId)
// Не путать с prisma_users — здесь userId = UUID из Supabase Auth.
// ---------------------------------------------------------------------------

/// Справочник бейджей (сидируется при первом запросе или миграцией)
model Achievement {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  iconEmoji     String   @map("icon_emoji")
  xpReward      Int      @map("xp_reward")
  /// CASES_COMPLETED | CORRECT_STREAK | LESSONS_COMPLETED | LOGIN_STREAK | MODULE_COMPLETION
  criteriaType  String   @map("criteria_type")
  criteriaValue Int      @map("criteria_value")
  /// orads | iota | birads | tirads | fmf | general — null = любой модуль
  moduleId      String?  @map("module_id")
  createdAt     DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("prisma_achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("prisma_user_achievements")
}

model UserProgress {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  totalXp          Int       @default(0) @map("total_xp")
  level            Int       @default(1)
  streakDays       Int       @default(0) @map("streak_days")
  lastActiveDate   DateTime? @map("last_active_date") @db.Date
  /// Серия правильных интерпретаций IOTA (сбрасывается при ошибке)
  iotaCorrectStreak Int      @default(0) @map("iota_correct_streak")
  /// Агрегаты: casesByModule, lessonsCompleted, fmfPercent и т.д.
  stats            Json      @default("{}")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("prisma_user_progress")
}

model QuizResult {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  score     Float
  passed    Boolean  @default(false)
  passedAt  DateTime @default(now()) @map("passed_at")
  metadata  Json?

  @@index([userId, moduleId])
  @@index([userId, passedAt])
  @@map("prisma_quiz_results")
}

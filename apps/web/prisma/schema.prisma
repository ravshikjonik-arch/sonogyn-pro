// Prisma schema — SonoGyn Pro
//
// ВАЖНО: проект работает на Supabase Auth (auth.users) + Supabase migrations.
// Эта схема добавлена ОТДЕЛЬНО (coexistence): таблицы маппятся на собственные
// имена (@@map с суффиксами), чтобы НЕ перезаписать существующие таблицы Supabase
// (public.profiles, public.payments) и не сломать RLS / auth.*.
//
// НЕ запускайте `prisma migrate dev` против боевой Supabase-БД — Prisma увидит
// drift (auth-схему, RLS, существующие таблицы) и может предложить reset.
// Для применения используйте сгенерированный prisma/init.sql через Supabase SQL Editor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (Supabase: ...pooler.supabase.com:6543/postgres?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Прямое подключение для миграций/diff (Supabase: db.<ref>.supabase.co:5432)
  directUrl = env("DIRECT_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String?           @unique
  name          String?
  phone         String?           @unique
  phoneVerified Boolean           @default(false)
  image         String?
  role          String            @default("user") // user, admin
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  accounts      Account[]
  sessions      Session[]
  payments      Payment[]
  smsCodes      SMSVerification[]

  @@map("prisma_users")
}

// NextAuth — стандартная модель OAuth-аккаунтов
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("prisma_accounts")
}

// NextAuth — стандартная модель сессий
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prisma_sessions")
}

// NextAuth — токены подтверждения email
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("prisma_verification_tokens")
}

model SMSVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId])
  @@map("prisma_sms_verifications")
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int      // в копейках
  currency     String   @default("RUB")
  status       String   @default("pending") // pending, succeeded, canceled
  yookassaId   String?  @unique
  description  String?
  returnUrl    String?
  confirmation Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@map("prisma_payments")
}

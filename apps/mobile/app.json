{
  "expo": {
    "name": "SonoGyn Pro",
    "slug": "us-risk-calc",
    "scheme": "com.yakrav7700.usriskcalc",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yakrav7700.usriskcalc",
      "buildNumber": "16",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера: съёмка снимков для разделов AI и чата врачей.",
        "NSPhotoLibraryUsageDescription": "Галерея: выбор изображений для AI и чата.",
        "NSMicrophoneUsageDescription": "Микрофон: диктовка протокола УЗИ (серверная расшифровка Whisper).",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yakrav7700.usriskcalc",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07041a"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 24,
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "./plugins/withGradleJvmArgs.js",
      "./plugins/withClearAutolinkingCache.js",
      "./plugins/withIosPodsDeploymentTarget.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07041a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото для загрузки изображений в приложение.",
          "cameraPermission": "Доступ к камере для съёмки изображений."
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон: диктовка протокола УЗИ (серверная расшифровка Whisper)."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#005CB9"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "SonoGyn Pro",
      "shortName": "SonoGyn",
      "lang": "ru",
      "themeColor": "#005CB9",
      "backgroundColor": "#F8FBFF"
    },
    "extra": {
      "eas": {
        "projectId": "7a563271-84bd-4439-9b8b-e911adce3a44"
      }
    },
    "owner": "yakrav7700",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/7a563271-84bd-4439-9b8b-e911adce3a44"
    }
  }
}

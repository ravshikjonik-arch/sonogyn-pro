{
  "cli": {
    "version": ">=16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "pnpm": "10.6.5",
      "node": "22.14.0",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "GRADLE_OPTS": "-Xmx6144m -XX:MaxMetaspaceSize=1536m -Dorg.gradle.jvmargs=-Xmx6144m -XX:MaxMetaspaceSize=1536m",
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://sonogyn-pro.ru",
        "EXPO_PUBLIC_WEB_APP_URL": "https://sonogyn-pro.ru",
        "EXPO_PUBLIC_MOBILE_REQUIRE_REGISTRATION": "true",
        "EXPO_PUBLIC_MOBILE_SIMPLE_EMAIL_AUTH": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://grnwcbyslttbrqznnunq.supabase.co"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "pnpm": "10.6.5",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://sonogyn-pro.ru",
        "EXPO_PUBLIC_WEB_APP_URL": "https://sonogyn-pro.ru",
        "EXPO_PUBLIC_MOBILE_REQUIRE_REGISTRATION": "true",
        "EXPO_PUBLIC_MOBILE_SIMPLE_EMAIL_AUTH": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://grnwcbyslttbrqznnunq.supabase.co"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "93WGRS9WU7"
      }
    }
  }
}

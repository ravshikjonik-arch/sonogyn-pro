{
  "name": "ultrasound-saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "description": "SonoGyn Pro — ultrasound & OBGYN clinical platform. Foundation app: Expo Android + PWA; Next.js web in apps/web.",
  "scripts": {
    "install:deps": "CI=1 npx --yes pnpm@10.6.5 install --config.confirmModulesPurge=false --no-frozen-lockfile",
    "import:petra": "python3 scripts/import-petra-assistant.py",
    "import:blinov-atlas": "python3 scripts/import-blinov-atlas.py",
    "import:ozerskaya-adnex": "python3 scripts/import-ozerskaya-adnex.py",
    "dev:web": "npx --yes pnpm@10.6.5 --filter @repo/web dev",
    "dev:web:lan": "npx --yes pnpm@10.6.5 --filter @repo/web dev:lan",
    "dev:video": "npx --yes pnpm@10.6.5 --filter @repo/video studio",
    "render:video": "npx --yes pnpm@10.6.5 --filter @repo/video render",
    "terminal:info": "bash scripts/terminal-info.sh",
    "dev:mobile": "env -u CI npx --yes pnpm@10.6.5 --filter @repo/mobile start",
    "dev:mobile:clear": "env -u CI npx --yes pnpm@10.6.5 --filter @repo/mobile start:clear",
    "expo": "bash scripts/expo-start.sh",
    "start:mobile": "bash scripts/expo-start.sh",
    "build": "npx --yes pnpm@10.6.5 exec turbo build",
    "lint": "npx --yes pnpm@10.6.5 exec turbo lint",
    "typecheck": "npx --yes pnpm@10.6.5 exec turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "sync:guidelines": "npx --yes pnpm@10.6.5 --filter @repo/clinical-guidelines sync",
    "audit:navigation": "npx --yes pnpm@10.6.5 --filter @repo/types test && npx --yes pnpm@10.6.5 --filter @repo/web audit:navigation-icons && npx --yes pnpm@10.6.5 --filter @repo/web test:navigation",
    "setup:githooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit",
    "test:e2e": "npx --yes pnpm@10.6.5 --filter @repo/web test:e2e",
    "test:cpi": "npx --yes pnpm@10.6.5 --filter @repo/cervical-pathology test"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-regenerator": "7.28.4",
      "@eslint/config-array": "0.23.5"
    }
  }
}

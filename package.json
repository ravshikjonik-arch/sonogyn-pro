{
  "name": "ultrasound-saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "description": "SonoGyn Pro — ultrasound & OBGYN clinical platform. Foundation app: Expo Android + PWA; Next.js web in apps/web.",
  "scripts": {
    "install:deps": "CI=1 npx --yes pnpm@10.6.5 install --config.confirmModulesPurge=false --no-frozen-lockfile",
    "import:petra": "python3 scripts/import-petra-assistant.py",
    "import:blinov-atlas": "python3 scripts/import-blinov-atlas.py",
    "import:shaaban-gyn-atlas": "python3 scripts/import-shaaban-gyn-atlas.py",
    "import:woodward-ob-atlas": "python3 scripts/import-woodward-ob-atlas.py",
    "import:cervix-morpho-atlas": "python3 scripts/import-cervix-morpho-atlas.py",
    "import:kaprin-mammology-atlas": "python3 scripts/import-kaprin-mammology-atlas.py",
    "import:prenatal-echo-atlas": "python3 scripts/import-prenatal-echo-atlas.py",
    "import:otto-echo-atlas": "python3 scripts/import-otto-echo-atlas.py",
    "import:desktop-books": "python3 scripts/import-cervix-morpho-atlas.py --skip-copy-images && python3 scripts/import-kaprin-mammology-atlas.py --skip-copy-images && python3 scripts/import-prenatal-echo-atlas.py --skip-copy-images && python3 scripts/import-otto-echo-atlas.py",
    "verify:desktop-books": "node scripts/verify-desktop-book-imports.mjs",
    "generate:book-nosology": "node packages/book-nosology-registry/scripts/generate-registry.mjs",
    "upload:clinical-atlas-supabase": "node apps/web/scripts/upload-clinical-atlas-all.mjs",
    "ingest:rf-regulations": "node apps/web/scripts/ingest-rf-regulations.mjs",
    "sync:regulations-catalog": "node --import tsx apps/web/scripts/sync-regulations-to-catalog.ts",
    "run:regulation-pipeline-once": "node --import tsx apps/web/scripts/run-regulation-pipeline-once.ts",
    "import:neishtadt-ovarian-atlas": "python3 scripts/import-neishtadt-ovarian-atlas.py",
    "import:ozerskaya-adnex": "python3 scripts/import-ozerskaya-adnex.py",
    "knowledge:woodward:extract": "python3 scripts/extract-woodward-obstetrics.py",
    "knowledge:woodward:ru": "python3 scripts/localize-woodward-ru.py",
    "test:obstetric-dx": "node --import tsx --test services/differentialDiagnosis.test.ts",
    "test:sonographer": "node --import tsx --test services/sonographerAssistant.test.ts",
    "test:fetal-biometry": "node --import tsx --test services/fetalBiometryEngine.test.ts",
    "test:doppler": "node --import tsx --test services/dopplerEngine.test.ts",
    "test:aneuploidy": "node --import tsx --test services/aneuploidyRiskEngine.test.ts",
    "test:obstetric-expert": "node --import tsx --test services/differentialDiagnosis.test.ts services/sonographerAssistant.test.ts services/fetalBiometryEngine.test.ts services/dopplerEngine.test.ts services/aneuploidyRiskEngine.test.ts services/obstetricCopilot.test.ts",
    "test:musa-adenomyosis": "npm run test --prefix packages/musa-framework",
    "dev:web": "npx --yes pnpm@10.6.5 --filter @repo/web dev",
    "dev:web:lan": "npx --yes pnpm@10.6.5 --filter @repo/web dev:lan",
    "dev:video": "npx --yes pnpm@10.6.5 --filter @repo/video studio",
    "render:video": "npx --yes pnpm@10.6.5 --filter @repo/video render",
    "terminal:info": "bash scripts/terminal-info.sh",
    "dev:mobile": "env -u CI EXPO_OFFLINE=1 npx --yes pnpm@10.6.5 --filter @repo/mobile start",
    "dev:mobile:clear": "env -u CI EXPO_OFFLINE=1 npx --yes pnpm@10.6.5 --filter @repo/mobile start:clear",
    "expo": "bash scripts/expo-start.sh",
    "start:mobile": "bash scripts/expo-start.sh",
    "build": "npx --yes pnpm@10.6.5 exec turbo build",
    "lint": "npx --yes pnpm@10.6.5 exec turbo lint",
    "typecheck": "npx --yes pnpm@10.6.5 exec turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "sync:guidelines": "npx --yes pnpm@10.6.5 --filter @repo/clinical-guidelines sync",
    "audit:navigation": "npx --yes pnpm@10.6.5 --filter @repo/types test && npx --yes pnpm@10.6.5 --filter @repo/web audit:navigation-icons && npx --yes pnpm@10.6.5 --filter @repo/web test:navigation",
    "setup:githooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit",
    "test:e2e": "npx --yes pnpm@10.6.5 --filter @repo/web test:e2e",
    "test:cpi": "npx --yes pnpm@10.6.5 --filter @repo/cervical-pathology test",
    "check:migration-drift": "node scripts/check-migration-drift.mjs",
    "test:iota": "pnpm --filter @repo/iota-models test",
    "test:orads-us": "pnpm --filter @repo/orads-us test",
    "test:fetal-nomograms": "pnpm --filter @repo/fetal-nomograms test",
    "validate:hofer-course": "pnpm --filter @repo/hofer-basic-course validate",
    "validate:tirads-course": "pnpm --filter @repo/tirads-basic-course validate",
    "verify:orads-tree-snapshot": "node --import tsx packages/orads-us/scripts/verify-decision-tree-snapshot.mjs",
    "verify:birads-rules-snapshot": "node packages/birads-us/scripts/verify-rules-snapshot.mjs",
    "test:imaging-cds": "pnpm --filter @repo/web test:imaging-cds",
    "eval:imaging-cds": "node --import tsx scripts/imaging-cds-eval.mjs --manifest docs/clinical-imaging-cds/golden-set/manifest.synthetic-ci.json",
    "test:e2e:iota": "pnpm --filter @repo/web test:e2e:iota"
  },
  "devDependencies": {
    "@babel/traverse--for-generate-function-map": "npm:@babel/traverse@^7.25.3",
    "turbo": "^2.11.10",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-regenerator": "7.28.4",
      "@eslint/config-array": "0.23.5",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "metro-cache-key": "0.84.5"
    }
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "big.js": "^7.0.1",
    "metro-cache-key": "0.84.5"
  }
}

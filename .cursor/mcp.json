{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.2.5"
      ]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ]
    },
    "creator-mcp": {
      "url": "https://creator.mcp.lottiefiles.com/mcp"
    }
  }
}

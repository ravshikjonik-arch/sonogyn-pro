{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/yookassa/webhook",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}

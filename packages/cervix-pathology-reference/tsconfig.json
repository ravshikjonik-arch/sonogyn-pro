{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts", "self-assessment/data/**/*.json", "chapters/**/*.json", "chapters/**/*.md"]
}

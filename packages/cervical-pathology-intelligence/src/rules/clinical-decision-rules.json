      "blockId": "block8-risk",
      "when": {
        "all": [
          { "field": "input.currentBiopsyResult", "op": "eq", "value": "cin2" },
          { "field": "input.pregnancy", "op": "eq", "value": false }
        ]
      },
      "actions": ["targeted_biopsy", "hpv_test_12mo", "repeat_colposcopy"],
      "actionPriority": "conditional",
      "explanation": "CIN2 у молодых / планирующих беременность — наблюдение 12 мес с repeat colposcopy (ASCCP 2019 manage-or-observe). При persistence >24 мес или non-compliance — excision (LLETZ).",
      "sourceIds": ["asccp-2019", "esgo-cervical-2023"]

    {
      "id": "hpv18-glandular",
      "titleRu": "HPV18 — железистый маршрут",
      "priority": 74,
      "blockId": "block2-hpv",
      "when": { "field": "input.hpv18Positive", "op": "eq", "value": true },
      "actions": ["ecc", "targeted_biopsy"],
      "actionPriority": "conditional",
      "explanation": "HPV18 ассоциирован с AIS/адenocarcinoma — ECC при AGC/TZ3.",
      "sourceIds": ["asccp-2019", "who-2021"]
    },
    {
      "id": "quality-incomplete-repeat",
      "titleRu": "Низкий quality score — дополнить протокол",
      "priority": 20,
      "blockId": "block7-quality",
      "when": { "field": "quality.score", "op": "lt", "value": 70 },
      "actions": ["repeat_colposcopy"],
      "actionPriority": "conditional",
      "explanation": "Quality score <70 — неполная документация; повторить/дополнить фото, TZ, adequacy (best practice IFCPC).",
      "sourceIds": ["ifcpc-2011"]
    },
    {
      "id": "self-collection-hpv16-18-biopsy",
      "titleRu": "Self-collection HPV+ 16/18 → биопсия без triage",
      "priority": 86,
      "blockId": "block2-hpv",
      "when": {
        "all": [
          { "field": "input.hpv16Positive", "op": "eq", "value": true },
          { "field": "input.collectionMethod", "op": "eq", "value": "self" },
          { "field": "flags.invasionSignsPresent", "op": "eq", "value": false }
        ]
      },
      "actions": ["targeted_biopsy", "repeat_colposcopy"],
      "actionPriority": "primary",
      "explanation": "Self-collected HPV+ с генотипированием 16/18+ → немедленная кольпоскопия с биопсией без промежуточного cytology triage (ASCCP Enduring Guidelines 2025; FDA self-collection 2024).",
      "sourceIds": ["asccp-enduring-2025-self-collection", "acs-2025", "acog-2026"]
    },
    {
      "id": "extended-genotyping-56-59-66-repeat",
      "titleRu": "Extended genotyping: HPV 56/59/66+ → повтор через 12 мес",
      "priority": 38,
      "blockId": "block2-hpv",
      "when": {
        "all": [
          { "field": "input.hpv3133455258Positive", "op": "eq", "value": false },
          { "field": "input.hpv16Positive", "op": "eq", "value": false },
          { "field": "input.hpv18Positive", "op": "eq", "value": false },
          { "field": "input.otherHrHpvPositive", "op": "eq", "value": true },
          { "field": "input.cytology", "op": "eq", "value": "nilm" }
        ]
      },
      "actions": ["hpv_test_12mo", "observation"],
      "actionPriority": "secondary",
      "explanation": "Extended genotyping: HPV 56/59/66+ при NILM — низкий риск CIN3+, повтор HPV через 12 мес (ASCCP Enduring Guidelines 2025, Massad et al.).",
      "sourceIds": ["asccp-enduring-2025-genotyping", "asccp-2019"]
    },
    {
      "id": "dual-stain-triage-hpv-positive",
      "titleRu": "p16/Ki67 Dual Stain+ при HPV+ → кольпоскопия",
      "priority": 62,
      "blockId": "block2-hpv",
      "when": {
        "all": [
          { "field": "input.hpvStatus", "op": "eq", "value": "positive" },
          { "field": "input.cytology", "op": "in", "value": ["nilm", "ascus"] },

{
  "name": "@repo/evidence-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"skip\"",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "test:golden": "node --import tsx eval/run-golden-structural.mjs",
    "eval:hybrid-ab:soft": "node --import tsx eval/run-hybrid-ab-soft.mjs",
    "eval:promptfoo:soft": "echo \"Structural golden: pnpm test:golden. Live promptfoo: npx promptfoo@0.118.0 eval (opt-in)\""
  },
  "dependencies": {
    "@repo/clinical-guidelines": "workspace:*",
    "@repo/evidence-corpus": "workspace:*",
    "@repo/evidence-engine": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}

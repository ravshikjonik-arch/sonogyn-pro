    "positive": { "normal": -0.4, "cin1": 0.2, "cin2": 0.5, "cin3": 0.4, "ais": 0.2, "invasion": 0.1 },
    "hpv16": { "normal": -1.2, "cin1": -0.3, "cin2": 0.6, "cin3": 1.2, "ais": 0.3, "invasion": 0.4 },
    "hpv18": { "normal": -0.8, "cin1": -0.4, "cin2": 0.3, "cin3": 0.5, "ais": 1.4, "invasion": 0.8 },
    "other_hr": { "normal": -0.5, "cin1": 0.1, "cin2": 0.4, "cin3": 0.3, "ais": 0.2, "invasion": 0.1 }
  },
  "transformationZone": {
    "tz1": { "normal": 0.1, "cin1": 0.0, "cin2": 0.0, "cin3": 0.0, "ais": 0.0, "invasion": 0.0 },

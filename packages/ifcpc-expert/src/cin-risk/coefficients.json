    ],
    "invasion": [
      { "tier": "negligible", "max": 0.01, "color": "#22c55e", "labelRu": "Минимальный" },
      { "tier": "low", "max": 0.05, "color": "#14b8a6", "labelRu": "Низкий" },
      { "tier": "moderate", "max": 0.15, "color": "#f59e0b", "labelRu": "Умеренный" },
      { "tier": "high", "max": 1.0, "color": "#dc2626", "labelRu": "Высокий" }
    ]
  }
}

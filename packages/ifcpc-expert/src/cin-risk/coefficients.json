    "repeat_treatment": { "normal": -1.0, "cin1": -0.3, "cin2": 0.5, "cin3": 0.7, "ais": 0.4, "invasion": 0.3 }
  },
  "clinicalModifiers": {
    "immunodeficiency": { "normal": -0.5, "cin1": 0.1, "cin2": 0.35, "cin3": 0.45, "ais": 0.3, "invasion": 0.4 },
    "pregnancy": { "normal": 0.3, "cin1": 0.2, "cin2": -0.15, "cin3": -0.25, "ais": -0.2, "invasion": -0.3 },
    "age_under25": { "normal": 0.4, "cin1": 0.3, "cin2": -0.2, "cin3": -0.35, "ais": -0.2, "invasion": -0.3 },
    "age_25_34": { "normal": 0.1, "cin1": 0.1, "cin2": 0.0, "cin3": -0.1, "ais": 0.0, "invasion": 0.0 },
    "age_35_49": { "normal": 0.0, "cin1": 0.0, "cin2": 0.05, "cin3": 0.05, "ais": 0.0, "invasion": 0.0 },
    "age_50_plus": { "normal": -0.1, "cin1": -0.2, "cin2": 0.1, "cin3": 0.15, "ais": 0.25, "invasion": 0.2 }
  },
  "riskTierThresholds": {

{
  "$schema": "https://sonogyn.pro/schemas/cin-risk-model.v1.json",
  "meta": {
    "id": "sonogyn-cin-risk-v1",
    "title": "SonoGyn CIN Risk Model v1",
    "version": "1.0.0",
    "method": "multinomial-logit",
    "disclaimer": "Клиническая DSS-модель для стратификации риска на кольпоскопии. Калибровка по публикациям ASCCP 2019, Swede Score, IFCPC 2011. Не заменяет гистологию.",
    "references": [
      "ASCCP 2019 Risk-Based Management Consensus",
      "Bornstein J et al. 2011 IFCPC Colposcopy Nomenclature",
      "Strander B et al. Swede Score validation",
      "Katki HA et al. CIN3+ risk estimates (NCI)"
    ],
    "formula": {
      "description": "Мультиномиальная логистическая модель по 6 исходам гистологии",
      "logit": "L_k = β0_k + Σ(w_i,k · x_i)",
      "probability": "P_k = exp(L_k) / Σ_j exp(L_j)",
      "cin2plus": "P(CIN2+) = P(CIN2) + P(CIN3) + P(AIS) + P(invasion)",
      "note": "β0_k — априор от цитологии Bethesda + HPV; x_i — бинарные/категориальные предикторы; w из coefficients"
    }
  },
  "outcomes": ["normal", "cin1", "cin2", "cin3", "ais", "invasion"],
  "bethesdaPriors": {
    "nilm": { "normal": 2.8, "cin1": -0.5, "cin2": -2.2, "cin3": -3.0, "ais": -3.5, "invasion": -4.5 },
    "ascus": { "normal": 1.2, "cin1": 0.4, "cin2": -1.0, "cin3": -2.0, "ais": -2.5, "invasion": -3.5 },
    "lsil": { "normal": 0.2, "cin1": 1.0, "cin2": -0.3, "cin3": -1.5, "ais": -2.0, "invasion": -3.0 },
    "asc_h": { "normal": -1.5, "cin1": -0.2, "cin2": 1.2, "cin3": 0.8, "ais": 0.2, "invasion": -1.0 },
    "hsil": { "normal": -2.5, "cin1": -1.0, "cin2": 0.8, "cin3": 1.5, "ais": 0.5, "invasion": -0.5 },
    "agc": { "normal": -2.0, "cin1": -0.8, "cin2": 0.5, "cin3": 0.8, "ais": 1.8, "invasion": 0.6 },
    "unsatisfactory": { "normal": 0.5, "cin1": 0.0, "cin2": -0.5, "cin3": -1.0, "ais": -1.0, "invasion": -1.5 }
  },
  "hpvModifiers": {

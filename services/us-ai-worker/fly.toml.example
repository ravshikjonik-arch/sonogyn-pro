# Plan B / scale: copy to fly.toml, set secrets via `fly secrets set`.
# Docs: docs/architecture/US-AI-SCALE-100-1000.md

app = "sonogyn-us-ai"
primary_region = "fra"

[build]
  dockerfile = "Dockerfile"

[http_service]
  internal_port = 8090
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1
  # Phase 1: fly scale count 2
  processes = ["app"]

[[vm]]
  memory = "2gb"
  cpu_kind = "shared"
  cpus = 2

# fly secrets set US_AI_WORKER_SECRET=... OPENROUTER_API_KEY=... US_VISION_MODEL=openai/gpt-4o-mini
